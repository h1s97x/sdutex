%%
%% \subsection{Abstract Environments}
%%
%% These are shared by every degree type, so they stay in the kernel.
%%
%% Chinese abstract.
%%    \begin{macrocode}
%<!CLASS>
\NewDocumentEnvironment { cnabstract } { } {
  \phantomsection
  \pdfbookmark[0] { 摘要 } { cnabstract }
  \begin{center}
    \zihao{3} \bfseries \heiti { 摘\qquad 要 }
  \end{center}
  \vspace{12pt}
  \setlength{\parindent}{1.2em}
  \zihao{-4}
}{
  \vspace{1cm}
  \par \noindent
  \zihao{-4} \bfseries \heiti { 关键词： }
  \zihao{-4} \GetCnKeywords
  \clearpage
}
%    \end{macrocode}
%%
%% English abstract.
%%    \begin{macrocode}
%<!CLASS>
\NewDocumentEnvironment { enabstract } { } {
  \phantomsection
  \pdfbookmark[0] { Abstract } { enabstract }
  \begin{center}
    \zihao{-2} \bfseries { ABSTRACT }
  \end{center}
  \vspace{12pt}
  \setlength{\parindent}{1.2em}
  \zihao{-4}
}{
  \vspace{1cm}
  \par \noindent
  \zihao{-4} \bfseries { Keywords: }
  \zihao{-4} \GetEnKeywords
  \clearpage
}
%    \end{macrocode}
