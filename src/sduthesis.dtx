%%   \item 4 = doctor (博士)
%% \end{itemize}
%%    \begin{macrocode}
%<!CLASS>
\int_new:N \g_@@_type_int
\int_new:N \g_@@_type_major_int
\int_new:N \g_@@_type_professional_int
%    \end{macrocode}
%%
%% \begin{variable}{\g_@@_blind_bool}
