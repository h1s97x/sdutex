%%
%% \subsection{Appendix}
%%
%% Appendix command (shared by all degrees).
%%    \begin{macrocode}
%<!CLASS>
\NewDocumentCommand \MakeAppendix { } {
  \appendix
  \counterwithin { equation } { chapter }
  \counterwithin { figure } { chapter }
  \counterwithin { table } { chapter }
}
%    \end{macrocode}
