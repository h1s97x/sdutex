% \subsection{定理环境}
%
% 内置丰富的定理环境：\texttt{definition}（定义）、\texttt{theorem}（定理）、
% \texttt{lemma}（引理）、\texttt{corollary}（推论）、\texttt{proposition}
% （命题）、\texttt{proof}（证明）、\texttt{assumption}（假设）、
% \texttt{conjecture}（猜想）、\texttt{remark}（注）、\texttt{example}（例）。
% 所有定理环境均带章节编号。
%
% \subsection{Getter 命令}
%
% 提供便捷的取值命令：\texttt{\textbackslash GetLang}、
% \texttt{\textbackslash GetMathStyle}、\texttt{\textbackslash GetPreset}、
% \texttt{\textbackslash GetDegreeName}、\texttt{\textbackslash GetDegreeNameEn}、
% \texttt{\textbackslash GetSupervisorEn}、\texttt{\textbackslash GetCoSupervisorEn}。
