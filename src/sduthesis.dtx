% \section{项目简介}
%
% SDUTeX 是山东大学学位论文 \LaTeX{} 模板的核心代码仓库，旨在为山东大学
% 师生提供一套符合学校学位论文格式规范、开箱即用且可扩展的 \LaTeX{}
% 工具集。它支持本科、硕士、专业硕士、博士四种学位类型，支持中英文双语
% 写作、盲审模式、图表目录自动生成与 GB/T 7714--2015 参考文献格式。
%
% 项目基于 \LaTeX3{}（\texttt{expl3}）现代化语法开发，采用
% 「内核 + 模块 + Hook」的插件化架构，并配有 \texttt{l3build} 自动化测试
% 体系，在 XeLaTeX 与 LuaLaTeX 双引擎下均可编译。
%
% \subsection{核心产物}
%
% \begin{tabular}{lll}
%   \toprule
%   产物文件 & 类型 & 说明 \\
%   \midrule
%   \texttt{sduthesis.cls} & 文档类 & 学位论文文档类（核心引擎） \\
%   \texttt{sdutex.sty}    & 宏包   & 工具宏包（数学/浮动体/格式工具） \\
%   \texttt{sduthesis.bst} & BibTeX & GB/T 7714--2015 参考文献样式 \\
%   \texttt{modules/*.sty} & 模块   & 学位类型与盲审模块（4 个） \\
%   \bottomrule
% \end{tabular}
%
% \subsection{技术栈}
%
% \begin{tabular}{ll}
%   \toprule
%   分类 & 技术 \\
%   \midrule
%   编程语言 & \LaTeX3{} (\texttt{expl3})、\TeX{}、BibTeX \\
%   构建系统 & \texttt{l3build} (Lua)、GNU Make \\
%   文档格式 & DTX（Documented \LaTeX{} sources） \\
%   测试引擎 & XeLaTeX、LuaLaTeX \\
%   \bottomrule
% \end{tabular}
%
% \section{安装}
%
% \subsection{环境要求}
%
% 推荐安装 TeX Live 2024 或更新版本。Windows / macOS / Linux 均可使用。
%
% \subsection{从源码安装}
%
% \begin{lstlisting}
% # 解包 DTX 文件
% l3build unpack
%
% # 安装到本地 TeX 目录
% l3build install
% \end{lstlisting}
%
% \subsection{直接使用}
%
% 将 \texttt{src/} 目录下的 \texttt{.cls}、\texttt{.sty}、\texttt{.bst}
% 文件复制到你的项目目录即可直接使用。
%
% \subsection{构建命令}
%
% \begin{tabular}{ll}
%   \toprule
%   命令 & 说明 \\
%   \midrule
%   \texttt{make}        & 解包并生成文件 \\
%   \texttt{make install} & 安装到本地 TeX 目录 \\
%   \texttt{make test}   & 运行测试 \\
%   \texttt{make clean}  & 清理生成的文件 \\
%   \texttt{l3build check / ctan / tds} & 测试 / 打包 CTAN / 打包 TDS \\
%   \bottomrule
% \end{tabular}
