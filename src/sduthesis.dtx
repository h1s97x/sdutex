% \section{快速开始}
%
% \subsection{方式一：推荐（info 分组键值）}
%
% 使用 \texttt{info} 分组键值，中英双语在同一条目下集中配置，写法对齐
% SJTUTeX：
%
% \begin{lstlisting}
% \documentclass[degree=bachelor]{sduthesis}
%
% \SDUSetup{
%   info = {
%     zh/title = {基于深度学习的图像识别研究},
%     en/title = {Research on Deep Learning based Image Recognition},
%     zh/author = {张三},
%     en/author = {Zhang San},
%     zh/school = {计算机科学与技术学院},
%     zh/major = {计算机科学与技术},
%     en/major = {Computer Science and Technology},
%     zh/supervisor = {李教授},
%     zh/supervisor-title = {教授},
%     zh/student-id = {2021001234},
%     zh/date = {2025年6月},
%     zh/keywords = {深度学习, 图像识别},
%     en/keywords = {Deep Learning, Image Recognition}
%   }
% }
%
% \begin{document}
% % 生成封面
% \MakeCover
%
% % 中文摘要
% \begin{cnabstract}
% 本文研究了基于深度学习的图像识别方法...
% \end{cnabstract}
%
% % 英文摘要
% \begin{enabstract}
% This paper studies image recognition methods...
% \end{enabstract}
%
% % 目录与图表目录
% \tableofcontents
% \ListOfFigures
% \ListOfTables
%
% % 正文
% \chapter{引言}
% ...
% \end{document}
% \end{lstlisting}
%
% \subsection{方式二：旧式写法（向后兼容）}
%
% \begin{lstlisting}
% \documentclass[degree=bachelor]{sduthesis}
%
% \SDUSetup{
%   title = {基于深度学习的图像识别研究},
%   title* = {Research on Deep Learning based Image Recognition},
%   author = {张三},
%   author* = {Zhang San},
%   school = {计算机科学与技术学院},
%   major = {计算机科学与技术},
%   supervisor = {李教授},
%   supervisor-title = {教授},
%   student-id = {2021001234},
%   date = {2025年6月}
% }
%
% \begin{document}
% \MakeCover
% \begin{cnabstract} 摘要内容... \end{cnabstract}
% \begin{enabstract} Abstract... \end{enabstract}
% \tableofcontents
% \chapter{引言}
% ...
% \end{document}
% \end{lstlisting}
%
% \subsection{编译方式}
%
% 使用 XeLaTeX 或 LuaLaTeX 编译（需携带 bibtex 处理参考文献）：
%
% \begin{lstlisting}
% xelatex main.tex
% bibtex   main
% xelatex  main.tex
% xelatex  main.tex
% \end{lstlisting}
%
% \section{配置选项}
%
% \subsection{文档类选项}
%
% \begin{tabular}{lll}
%   \toprule
%   选项 & 值 & 说明 \\
%   \midrule
%   \texttt{degree}      & bachelor / master / professional / doctor & 学位类型 \\
%   \texttt{blind}       & true / false & 盲审模式 \\
%   \texttt{twoside}     & true / false & 双面打印 \\
%   \texttt{lang}        & zh / en / zh-en / en-zh & 文档语言 \\
%   \texttt{math-style}  & ISO / GB / french / upright & 数学风格 \\
%   \texttt{preset}      & sdu / sjtu / none & 预设风格 \\
%   \texttt{module}      & 逗号分隔列表 & 组合加载模块 \\
%   \bottomrule
% \end{tabular}
%
% \begin{quote}
% \textbf{注意：} \texttt{math-style}（及 \texttt{preset}）作为文档类选项在
% 类加载时即生效；若在导言区通过 \texttt{\textbackslash SDUSetup\{ math-style
% = ... \}} 修改，仅对后续设置生效，不会重新触发类加载时的样式调整。
% \end{quote}
%
% \subsection{info 分组键值}
%
% 支持的键值包括：\texttt{zh/title}、\texttt{en/title}、
% \texttt{zh/author}、\texttt{en/author}、\texttt{zh/student-id}、
% \texttt{zh/school}、\texttt{zh/major}、\texttt{en/major}、
% \texttt{zh/supervisor}、\texttt{zh/supervisor-title}、
% \texttt{en/supervisor}、\texttt{zh/co-supervisor}、
% \texttt{en/co-supervisor}、\texttt{zh/date}、\texttt{zh/keywords}、
% \texttt{en/keywords}。
%
% \subsection{页眉配置}
%
% 通过 \texttt{header-left} / \texttt{header-right} 配置页眉左右内容，并
% 可使用 \texttt{sduthesis} 页眉样式（默认左侧标题、右侧章节名）。
%
% \section{插件化架构（内核 + 模块 + Hook）}
%
% SDUTeX v1.1.0 采用「内核 + 模块 + Hook」插件化架构。核心包
% \texttt{sduthesis} 只负责引擎、Hook 与基础排版，学位类型相关逻辑（封面
% / 盲审）由独立模块承载。
%
% \begin{tabular}{ll}
%   \toprule
%   模块文件 & 对应学位类型 \\
%   \midrule
%   \texttt{sduthesis-undergraduate.sty} & 本科 \\
%   \texttt{sduthesis-master.sty}        & 硕士 / 专业硕士 \\
%   \texttt{sduthesis-doctor.sty}        & 博士 \\
%   \texttt{sduthesis-blindreview.sty}   & 盲审 \\
%   \bottomrule
% \end{tabular}
%
% \subsection{组合加载 module=}
%
% \begin{lstlisting}
% \documentclass{sduthesis}
%
% \SDUSetup{
%   module = {master, blindreview},   % 硕士 + 盲审
%   title = {...},
%   ...
% }
% \end{lstlisting}
%
% \subsection{内置 Hook}
%
% 内核提供 6 个命名 Hook 供扩展：\texttt{after-setup}、
% \texttt{before-cover}、\texttt{cover-style}、\texttt{frontmatter/begin}、
% \texttt{mainmatter/begin}、\texttt{backmatter/begin}。
%
