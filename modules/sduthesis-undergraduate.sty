\ProvidesPackage{sduthesis-undergraduate}[2026/08/18 v2.2.0 SDUThesis undergraduate module]

% ============================================================
% 本科生论文模块
% 通过 \SDUSetup{module=undergraduate} 加载
% 负责封面、摘要、页眉页脚等本科论文特有格式
% ============================================================

% 加载公共模块：封面排版命令（\Lwidth/\Rwidth/\titlewidth/\Lcolumn/\Rcolumn）
% 与摘要环境（cnabstract/enabstract/\cnkeywords/\enkeywords）由 common 统一提供，
% 避免与 master 等模块组合加载时重定义冲突。
\RequirePackage{sduthesis-common}

% -------------------- 封面排版 --------------------
\renewcommand{\makecoverpage}{
    \begin{center}
        \phantomsection
        \hypertarget{coverpage}{}
        \bookmark[dest=coverpage,level=0]{封面}

        \vspace*{5mm}

        \includegraphics[width=0.7\textwidth]{logos/sdu_logo_2.pdf}

        \vspace*{10mm}

        \includegraphics[width=0.95\textwidth]{logos/sdu_title.png}

        \vspace*{5mm}

        \begin{flushleft}
            \zihao{3}\bfsong{论文（设计）题目：}
        \end{flushleft}

        \begin{minipage}{\titlewidth}
            \centering
            \zihao{-2}\bfhei{\GetTitle}
        \end{minipage}

        \vspace*{30mm}

        \begin{tabular}{p{\Lwidth}p{\Rwidth}}
            \IfBlindReviewF{\Lcolumn{姓\qquad 名} & \Rcolumn{\GetAuthor}     \\[-0.8mm]\cline{2-2}\\[-4mm]}
            \IfBlindReviewF{\Lcolumn{学\qquad 号} & \Rcolumn{\GetStudentId}  \\[-0.8mm]\cline{2-2}\\[-4mm]}
            \Lcolumn{学\qquad 院} & \Rcolumn{\GetSchool}     \\[-0.8mm]\cline{2-2}\\[-4mm]
            \Lcolumn{专\qquad 业} & \Rcolumn{\GetMajor}      \\[-0.8mm]\cline{2-2}\\[-4mm]
            \IfBlindReviewF{\Lcolumn{指导教师}      & \Rcolumn{\GetSupervisor}  \\[-0.8mm]\cline{2-2}}
        \end{tabular}

        \vspace*{35mm}

        \zihao{3}\bfkai{
          \GetYear 年 \quad
          \GetMonth 月
        }
    \end{center}

    \clearpage
}

% 摘要环境与关键词命令由公共模块 sduthesis-common 统一提供
% （cnabstract / enabstract / \cnkeywords / \enkeywords）。

% -------------------- 页眉页脚 --------------------
% 前言：空白页眉页脚
\AddToHook{sduthesis/frontmatter/begin}{
    \pagestyle{empty}
}

% 正文：山东大学本科毕业论文
\AddToHook{sduthesis/mainmatter/begin}{
    \fancypagestyle{plain}{
      \fancyhf{}
      \renewcommand{\headrulewidth}{0.5pt}
      \fancyhead[C]{\zihao{-5}\songti 山东大学本科毕业论文（设计）}
      \fancyfoot[C]{\zihao{-5}\thepage}
    }
    \pagestyle{plain}
    \linespread{1.3}\selectfont
}

% 后记：不编号章标题，小二号
\AddToHook{sduthesis/backmatter/begin}{
    \ctexset{
      chapter={
        format=\centering\zihao{-2}\bfseries,
        beforeskip=21.6pt,
        afterskip=18pt,
        fixskip=true,
       }
    }
}

\endinput
