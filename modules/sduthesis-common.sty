\ProvidesPackage{sduthesis-common}[2026/08/18 v2.2.0 SDUThesis common module]

% ============================================================
% 封面排版通用命令（master/undergraduate 共用）
% 使用 \providecommand：多模块组合加载时仅首次定义生效，
% 避免 "already defined" 冲突。
% ============================================================
\providecommand{\Lwidth}{2.3cm}
\providecommand{\Rwidth}{5.5cm}
\providecommand{\titlewidth}{0.9\textwidth}

\providecommand{\Lcolumn}[1]{\makebox[\Lwidth][c]{{\zihao{3}\bfkai{#1}}}}
\providecommand{\Rcolumn}[1]{\makebox[\Rwidth][c]{{\zihao{3}\kai{#1}}}}

% ============================================================
% 摘要环境（master/undergraduate 共用）
% 内核已定义空占位（cnabstract / enabstract / \cnkeywords / \enkeywords），
% 这里用 \renewenvironment / \renewcommand 提供真实排版；
% 二者均由本公共模块统一处理，避免模块间重复定义。
% ============================================================
\renewenvironment{cnabstract}{
    \phantomsection
    \hypertarget{cnabstract}{}
    \bookmark[dest=cnabstract,level=0]{中文摘要}

    \vspace*{12pt}
    \centerline{\zihao{-2}\bfhei{摘\quad 要}}
    \vspace*{12pt}

    \setlength{\parindent}{1.2em}
    \zihao{-4}
}{
    \clearpage
}

\renewenvironment{enabstract}{
    \phantomsection
    \hypertarget{enabstract}{}
    \bookmark[dest=enabstract,level=0]{英文摘要}

    \vspace*{12pt}
    \centerline{\zihao{-2}\textbf{ABSTRACT}}
    \vspace*{12pt}

    \setlength{\parindent}{1.2em}
    \zihao{-4}
}{
    \clearpage
}

\renewcommand{\cnkeywords}[1]{
    \vspace{1cm}
    \noindent{\zihao{-4}\bfhei{关键词}：}
    {#1}
}

\renewcommand{\enkeywords}[1]{
    \vspace{1cm}
    \noindent{\zihao{-4}\textbf{Keywords}:}
    {#1}
}

\endinput
